# Serveur tmux permanent (utilisateur), pour l'installation Docker de Keep An Eye.
# Le conteneur n'embarque qu'un client tmux : les sessions vivent ici, sur l'hôte, et survivent
# aux redémarrages et mises à jour du conteneur. Tes propres « tmux » s'y rattachent aussi.

[Unit]
Description=Serveur tmux permanent (Keep An Eye)

[Service]
Type=simple
# -D : le serveur reste au premier plan, systemd le surveille (et -D coupe exit-empty, il vit
# même sans aucune session). S'il plante, systemd le relance — les sessions en cours sont perdues.
ExecStart=/usr/bin/tmux -D
Restart=on-failure
RestartSec=2
# Attention : arrêter ou redémarrer ce service tue tmux et toutes les sessions.

[Install]
WantedBy=default.target
