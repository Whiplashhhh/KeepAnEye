# Keep An Eye — configuration (copie ce fichier en .env et adapte-le).
# Les chemins acceptent ~ et sont relatifs au dossier de l'appli sinon.

# Écoute réseau : TOUJOURS le loopback. L'appli refuse de démarrer sur une autre adresse ;
# l'accès depuis tes appareils passe par « tailscale serve ».
KAE_HOST=127.0.0.1
KAE_PORT=7777

# Origine(s) autorisée(s), séparées par des virgules : l'URL exacte servie par Tailscale.
# Toute requête qui modifie quelque chose et toute ouverture de WebSocket doivent venir d'ici.
KAE_ALLOWED_ORIGINS=https://machine.tailnet-1234.ts.net

# Base SQLite (comptes, sessions, journal d'audit, abonnements push).
KAE_DATA_DIR=./data

# claude-box : dossier du compose, projets, fichier d'événements des hooks, home de Claude (transcripts).
KAE_CLAUDE_BOX_DIR=~/claude-box
# KAE_WORKSPACE_DIR=~/claude-box/workspace
# KAE_EVENTS_FILE=~/claude-box/events/claude.jsonl
# KAE_CLAUDE_HOME_DIR=~/claude-box/claude-home

# Modèles de session (Terminal, Claude dans claude-box…). Copie le fichier pour en ajouter.
KAE_TEMPLATES_FILE=./config/templates.json

# tmux : binaire et socket (-L). Laisse KAE_TMUX_SOCKET vide pour ton serveur tmux habituel.
KAE_TMUX_BIN=tmux
# KAE_TMUX_SOCKET=

# Docker (état du conteneur claude-box via « docker compose ps »).
KAE_DOCKER_BIN=docker

# Nom affiché pour le serveur dans le bandeau d'état (par défaut : le hostname).
# KAE_HOST_LABEL=homelab

# Cookie de session « Secure » : laisse true (tailscale serve fournit le HTTPS).
KAE_COOKIE_SECURE=true

# Contact VAPID pour les notifications push (une adresse mailto: ou une URL).
KAE_VAPID_SUBJECT=mailto:moi@example.com

# Journalisation : fatal, error, warn, info, debug, trace, silent.
KAE_LOG_LEVEL=info
