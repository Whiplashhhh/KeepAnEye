{
  "templates": [
    {
      "id": "terminal",
      "label": "Terminal",
      "description": "Un shell simple sur l'hôte",
      "kind": "terminal",
      "command": [],
      "cwd": "{home}",
      "chooseCwd": true
    },
    {
      "id": "ssh",
      "label": "Machine SSH",
      "description": "Un terminal sur un autre serveur (VPS…), configuré dans les réglages",
      "kind": "terminal",
      "requiresSshHost": true,
      "keepOnFailure": true,
      "command": ["ssh", "-o", "ServerAliveInterval=30", "{ssh}"],
      "cwd": "{home}"
    },
    {
      "id": "claude",
      "label": "Claude dans claude-box",
      "description": "Claude Code isolé dans le conteneur, sur un projet",
      "kind": "claude",
      "requiresProject": true,
      "keepOnFailure": true,
      "cwd": "{claudeBoxDir}",
      "command": [
        "docker", "compose", "-f", "{claudeBoxDir}/compose.yml",
        "exec", "-u", "claude", "-w", "/workspace/{project}",
        "-e", "KEEP_AN_EYE_SESSION={session}",
        "claude", "claude", "{flags}"
      ],
      "models": [
        { "id": "fable", "label": "Fable", "description": "Le plus capable", "args": ["--model", "fable"] },
        { "id": "opus", "label": "Opus", "args": ["--model", "opus"] },
        { "id": "sonnet", "label": "Sonnet", "description": "Équilibré", "args": ["--model", "sonnet"] },
        { "id": "haiku", "label": "Haiku", "description": "Rapide et léger", "args": ["--model", "haiku"] }
      ],
      "efforts": [
        { "id": "low", "label": "Faible", "args": ["--effort", "low"] },
        { "id": "medium", "label": "Moyen", "args": ["--effort", "medium"] },
        { "id": "high", "label": "Élevé", "args": ["--effort", "high"] },
        { "id": "xhigh", "label": "Très élevé", "args": ["--effort", "xhigh"] },
        { "id": "max", "label": "Maximum", "args": ["--effort", "max"] }
      ],
      "flags": [
        {
          "id": "autonomous",
          "label": "Autonome",
          "description": "Lance claude --dangerously-skip-permissions : aucune confirmation demandée",
          "args": ["--dangerously-skip-permissions"]
        }
      ]
    }
  ]
}
